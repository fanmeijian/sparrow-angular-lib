            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/sparrow-breadcrumb/src/test.ts",
            "tsConfig": "projects/sparrow-breadcrumb/tsconfig.spec.json",
            "karmaConfig": "projects/sparrow-breadcrumb/karma.conf.js"
